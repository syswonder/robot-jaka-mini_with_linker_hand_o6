  <!-- ── LinkerHand O6 mount (end_effector: hand) ─────────────────────────
       Mechanical path: link_007 (JAKA Mini tool flange) → jaka_o6_adapter_link
       → hand_base_link. The adapter is the supplied JAKA Mini → O6 adapter
       STEP (source not kept in this repo), a 45° elbow:
       the 4×M6 face (50 mm PCD) bolts to the flange and the 20×20 mm M3 face
       carries the O6. The mesh is meshes/adapter/jaka_o6_adapter.stl, the
       STEP tessellated in its own frame (metres); mass/inertia below assume
       a uniform 2700 kg/m³ aluminium solid.
       The 4×M6 pattern is 90°-symmetric, so the adapter clocking is a choice
       of four: this pose maps adapter +X onto the flange hole at +33.04° in
       link_007 and puts adapter +Y (the connector cutout) toward +123.04°.
       To match a different clocking on the flange, change only the yaw of
       link_007_to_adapter by 90/180/270°; the hand follows. -->
  <link name="jaka_o6_adapter_link">
    <inertial>
      <origin xyz="0.000252 0.050383 -0.013001" rpy="0 0 0" />
      <mass value="0.224476" />
      <inertia ixx="1.818648e-04" ixy="-4.511158e-07" ixz="-3.898138e-07"
               iyy="1.289829e-04" iyz="-7.555363e-05" izz="1.896459e-04" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/adapter/jaka_o6_adapter.stl" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/adapter/jaka_o6_adapter.stl" />
      </geometry>
    </collision>
  </link>
  <joint name="link_007_to_adapter" type="fixed">
    <origin xyz="0.0222186 -0.0341394 -0.0598598" rpy="2.3561945 0 -2.5649359" />
    <parent link="link_007" />
    <child link="jaka_o6_adapter_link" />
  </joint>
  <joint name="adapter_to_hand" type="fixed">
    <!-- O6 clocking: 270° about the hand's bottom (+Z) axis = 90° + another
         180° (equivalent to -90°), counter-clockwise looking from the wrist
         toward the fingertips. The 20×20 mm M3 pattern is 90°-symmetric, so
         the four holes still land on the adapter; only the thumb/index/
         connector side changes. If the real hand is the other way, use
         +1.5707963. -->
    <origin xyz="0.000012 0.018631 -0.021738" rpy="0 0 4.712389" />
    <parent link="jaka_o6_adapter_link" />
    <child link="hand_base_link" />
  </joint>

